# required
API_KEY=                                               # service-to-service key
CREDENTIALS_KEY=                                       # 64 hex chars, encrypts connector credentials
DATABASE_URL=postgresql://user:pass@localhost:5432/nagomi
NAGOMI_GATEWAY_URL=http://localhost:55550
EXCHANGE_API_URL=https://api.frankfurter.dev/v1
S3_ENDPOINT=http://localhost:55580                     # any S3-compatible store
S3_BUCKET=nagomi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=garage

# optional
NAGOMI_RECEIPTS_URL=http://localhost:55556             # receipt parsing is off without it
NAGOMI_STATEMENTS_URL=http://localhost:55559           # statement import is off without it
LISTEN_ADDRESS=127.0.0.1:55555
LOG_LEVEL=info                                         # debug, info, warn, error
LOG_FORMAT=text                                        # text or json
TEST_DATABASE_URL=                                     # db tests only, falls back to DATABASE_URL
